---
import { SmartImage } from "../../utils/SmartImage";
---

<section
  class="relative z-10 mx-auto w-full max-w-[var(--container-max)] px-[var(--space-gutter)] pb-[var(--space-xl)] sm:px-[var(--space-gutter-md)] md:px-[var(--space-gutter-lg)] xl:px-[var(--space-gutter-lg)]"
>
  <div
    class="spotlight-card reveal-on-scroll relative overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-border-teal)] shadow-[var(--elevation-glow)] transition-transform duration-300 hover:scale-[1.01]"
  >
    <!-- تصویر پس‌زمینه -->
    <SmartImage
      src="/blogs/Story-Back.webp"
      alt=""
      fill={true}
      className="object-cover"
      sizes="(max-width: 768px) 100vw, 1200px"
    />

    <!-- overlay -->
    <div
      class="absolute inset-0 bg-linear-to-r from-[#0B1F2A]/90 to-[#00A9BD]/25"
    >
    </div>

    <!-- محتوا -->
    <div
      class="relative flex min-h-50 flex-col justify-center gap-[var(--space-sm)] px-[var(--space-sm)] py-[var(--space-lg)] text-center
                  sm:min-h-57.5 sm:gap-[var(--space-md)] sm:px-[var(--space-lg)] sm:py-[var(--space-lg)] sm:text-center
                  lg:min-h-65 lg:flex-row lg:items-center lg:justify-between lg:px-[var(--space-xl)]"
    >
      <!-- متن + دکمه -->
      <div class="w-full max-w-xl text-white mx-auto lg:mx-0 text-center flex items-center justify-center flex-col">
        <h2
          class="text-h2 text-white"
        >
          Let Your Story Move People.
        </h2>
        <p
          class="mt-[var(--space-2xs)] text-small text-white/85 sm:text-body"
        >
          Tell us what you're building — we'll bring it to life with motion.
        </p>
        <button
          class="mt-[var(--space-sm)] w-full max-w-60 mx-auto block cursor-pointer rounded-[var(--radius-md)]
                         px-5 py-2.5 text-xs font-medium text-white
                         shadow-[var(--elevation-glow)] transition duration-[var(--duration-normal)] ease-[var(--ease-default)]
                         sm:mt-[var(--space-md)] sm:mx-0 sm:w-auto sm:px-6 sm:py-3 sm:text-sm
                         hover:opacity-90 active:scale-95"
          style="background-image: var(--button-primary-bg)"
        >
          Start a Motion Project
        </button>
      </div>

      <!-- تصویر سمت راست -->
      <div
        class="relative hidden w-full max-w-96 self-center
                    sm:block sm:max-w-125
                    lg:max-w-150"
      >
        <SmartImage
          src="/about/svg/Story-Move.svg"

          alt="People discussing creative ideas"
          width={1379}
          height={1224}
          className="object-contain scale-120"
        />
      </div>
    </div>
  </div>
</section>
