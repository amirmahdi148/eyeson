---
import { SmartImage } from "@/utils/SmartImage";

type Logo = { src: string; alt: string };

type Props = {
  tagline?: string;
  logos?: Logo[];
};

const {
  tagline = "Trusted by creators, startups, SaaS teams, and modern brands across 25+ countries.",
  logos = [
    { src: "/Shared/OrbitIcons/icon1.webp", alt: "Client 1" },
    { src: "/Shared/OrbitIcons/icon2.webp", alt: "Client 2" },
    { src: "/Shared/OrbitIcons/icon3.webp", alt: "Client 3" },
    { src: "/Shared/OrbitIcons/icon4.webp", alt: "Client 4" },
    { src: "/Shared/OrbitIcons/icon5.webp", alt: "Client 5" },
    { src: "/Shared/OrbitIcons/icon6.webp", alt: "Client 6" },
    { src: "/Shared/OrbitIcons/icon7.webp", alt: "Client 7" },
    { src: "/Shared/OrbitIcons/icon8.webp", alt: "Client 8" },
    { src: "/Shared/OrbitIcons/icon9.webp", alt: "Client 9" },
    { src: "/Shared/OrbitIcons/icon10.webp", alt: "Client 10" },
    { src: "/Shared/OrbitIcons/icon11.webp", alt: "Client 11" },
    { src: "/Shared/OrbitIcons/icon12.webp", alt: "Client 12" },
  ],
} = Astro.props as Props;

// Quadruple logos for ultra-smooth, continuous tight loop
const loopLogos = [...logos, ...logos, ...logos, ...logos];
---

<section class="relative flex flex-col items-center gap-6 overflow-hidden pt-6 pb-2">
  <p class="text-center text-xs sm:text-sm font-medium tracking-wide text-white/70">{tagline}</p>

  <!-- ================= UNIFIED TIGHT MARQUEE ================= -->
  <div class="logo-mask w-full opacity-90" aria-label="Brand logos">
    <div class="logo-scroll flex w-max items-center">
      {
        loopLogos.map((logo, _index) => (
          <div class="logo-slot">
            <div class="logo-item group">
              <SmartImage
                src={logo.src}
                alt={logo.alt}
                width={160}
                height={64}
                loading="lazy"
                decoding="async"
                className="logo-img h-10 sm:h-12 md:h-14 w-auto object-contain"
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
  }

  .logo-img {
    opacity: 0.65;
    transition: opacity 0.3s ease, transform 0.3s ease, filter 0.3s ease;
    filter: grayscale(100%);
    will-change: opacity, transform, filter;
  }

  .logo-item:hover .logo-img {
    opacity: 1;
    filter: grayscale(0%);
    transform: scale(1.08);
  }

  /* ================= MARQUEE & MASK ================= */
  .logo-mask {
    --logo-gap: 0.5rem;
    overflow: hidden;

    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .logo-scroll {
    animation: logo-scroll-right 35s linear infinite;
    will-change: transform;
    gap: 0.75rem;
  }

  .logo-scroll:hover {
    animation-play-state: paused;
  }

  .logo-slot {
    flex: 0 0 auto;
    width: 130px;
  }

  @media (min-width: 640px) {
    .logo-slot {
      width: 160px;
    }
    .logo-scroll {
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .logo-slot {
      width: 180px;
    }
    .logo-scroll {
      gap: 1.5rem;
    }
  }

  @keyframes logo-scroll-right {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }
</style>
