</div>

<style>
  @keyframes hb-drift-a {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(42px, -30px, 0) scale(1.06); }
  }
  @keyframes hb-drift-b {
    from { transform: translate3d(0, 0, 0) scale(1.04); }
    to { transform: translate3d(-46px, 28px, 0) scale(1); }
  }
  @keyframes hb-drift-c {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(30px, 36px, 0) scale(1.07); }
  }
  @keyframes hb-fade-a {
    from { opacity: 0.55; }
    to { opacity: 1; }
  }
  @keyframes hb-fade-b {
    from { opacity: 1; }
    to { opacity: 0.6; }
  }
  @keyframes hb-fade-c {
    from { opacity: 0.7; }
    to { opacity: 0.95; }
  }
  .hb { will-change: transform, opacity; }
  .hb-1 { animation: hb-drift-a 11s ease-in-out -2s infinite alternate, hb-fade-a 8s ease-in-out -1s infinite alternate; }
  .hb-2 { animation: hb-drift-b 13s ease-in-out -5s infinite alternate, hb-fade-b 10s ease-in-out -4s infinite alternate; }
  .hb-3 { animation: hb-drift-c 15s ease-in-out -7s infinite alternate, hb-fade-c 9s ease-in-out -3s infinite alternate; }
  .hb-4 { animation: hb-drift-a 17s ease-in-out -9s infinite alternate-reverse, hb-fade-c 11s ease-in-out -6s infinite alternate; }
  .hb-5 { animation: hb-drift-b 12s ease-in-out -4s infinite alternate-reverse, hb-fade-a 9s ease-in-out -7s infinite alternate; }
  .hb-6 { animation: hb-drift-c 14s ease-in-out -8s infinite alternate, hb-fade-b 12s ease-in-out -2s infinite alternate; }

  @media (prefers-reduced-motion: reduce) {
    .hb { animation: none; }
  }
</style>
