---
import { SmartImage } from "@/utils/SmartImage";

interface CardItem {
  title: string;
  description: string;
  buttonText: string;
  imageUrl: string;
}

interface Props {
  headingTop?: string;
  headingBottom?: string;
  description?: string;
  cards?: CardItem[];
}

const {
  headingTop = "A Clear Process",
  headingBottom = "for Smooth Creative Delivery",
  description = "From first idea to final files, our workflow keeps every project organized, fast, and easy to\n" +
      "follow.",
  cards = [
    {
      title: "Discovery & Strategy",
      description: "We dive deep into your brand, understanding your goals and audience to craft a tailored creative strategy.",
      buttonText: "Learn more",
      imageUrl: "/home/home-frame.webp"
    },
    {
      title: "Concept & Storyboarding",
      description: "Translating strategies into visual stories. We storyboard every frame to ensure the narrative flows perfectly.",
      buttonText: "View process",
      imageUrl: "/home/eyes-home.webp"
    },
    {
      title: "Design & Animation",
      description: "Bringing ideas to life with high-end motion design, fluid animations, and stunning UI/UX deliverables.",
      buttonText: "See examples",
      imageUrl: "/home/home-frame.webp"
    },
    {
      title: "Delivery & Scaling",
      description: "Final polish, rendering, and delivery across all required formats, ready to scale your marketing efforts.",
      buttonText: "Get started",
      imageUrl: "/home/eyes-home.webp"
    }
  ],
} = Astro.props;
---

<section class="relative overflow-hidden py-[var(--space-2xl)] sm:py-[var(--space-3xl)] lg:py-[var(--space-3xl)]">
  <div class="relative mx-auto max-w-[var(--container-max)] px-[var(--space-gutter)] sm:px-[var(--space-gutter-md)] lg:px-[var(--space-gutter-lg)]">
    <div class="mx-auto max-w-4xl text-center">
      
      <h2 class=" text-h2">
        <span class="block bg-gradient-to-r from-[var(--primitive-teal-400)] via-[#60d6c6] to-[var(--primitive-teal-400)] bg-[length:200%_auto] animate-gradient bg-clip-text text-transparent pb-1">
          {headingTop}
        </span>
        <span class="mt-1 block text-white drop-shadow-md">
          {headingBottom}
        </span>
      </h2>

      <p class=" mt-[var(--space-sm)] text-small text-white/60 max-w-2xl mx-auto">
        {description}
      </p>
    </div>

    <!-- Swiper Container -->
    <div class="mt-[var(--space-xl)] ">
      <swiper-container init="false" class="mySwiper !pb-16">
        {cards.map((card) => (
          <swiper-slide class="h-auto">
            <article
              class="group relative flex h-full flex-col overflow-hidden rounded-[var(--card-radius-lg)] border border-[var(--color-border)] bg-gradient-to-b from-[#051821]/95 to-[#020a0f]/95 p-[var(--card-padding)] shadow-[var(--elevation-2)] backdrop-blur-xl transform-gpu transition-all duration-[var(--duration-slow)] ease-[var(--ease-default)] hover:border-[var(--color-border-teal)] hover:shadow-[var(--elevation-3)]"
            >
              <!-- Hover Border Glow Effect -->
              <div class="pointer-events-none absolute inset-0 rounded-[var(--card-radius-lg)] opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--duration-slow)]">
                <div class="absolute inset-[1px] rounded-[var(--card-radius)] border border-[var(--color-primary)]/50" />
                <div class="absolute top-0 inset-x-0 h-32 bg-gradient-to-b from-[var(--color-primary)]/10 to-transparent rounded-t-[var(--card-radius)]" />
              </div>

              <!-- Image -->
              <div class="relative mb-[var(--space-md)] overflow-hidden rounded-[var(--radius-lg)] border border-white/5 bg-[#0b222a] h-52 sm:h-64">
                <SmartImage
                  src={card.imageUrl}
                  alt={card.title}
                  fill
                  loading="lazy"
                  className="transform-gpu transition-transform duration-700 group-hover:scale-105"
                />
                {/* هاله تاریک پایین عکس برای خوانایی بهتر مرزها */}
                <div class="absolute inset-0 bg-gradient-to-t from-[#051821] to-transparent opacity-60"></div>
              </div>

              <div class="flex flex-1 flex-col z-10">
                <h3 class="text-xl font-extrabold text-white transition-colors duration-[var(--duration-normal)] group-hover:text-[var(--color-primary)]">
                  {card.title}
                </h3>
                <p class="mt-[var(--space-xs)] text-small leading-relaxed text-white/65 font-light flex-grow">
                  {card.description}
                </p>

                <div class="mt-[var(--space-lg)] flex justify-start transform transition-transform duration-[var(--duration-slow)] ease-[var(--ease-default)] group-hover:-translate-y-1">
                  <button class="inline-flex min-h-[var(--height-control-md)] items-center justify-center rounded-[var(--radius-md)] bg-white/5 border border-white/10 px-6 py-2.5 text-sm font-semibold text-white transition-all duration-[var(--duration-normal)] ease-[var(--ease-default)] hover:bg-[var(--color-primary)] hover:text-[#032024] hover:border-transparent hover:shadow-[var(--elevation-glow)] w-full sm:w-auto">
                    {card.buttonText}
                  </button>
                </div>
              </div>
            </article>
          </swiper-slide>
        ))}
      </swiper-container>
    </div>
  </div>
</section>

<style>
  /* ================= Gradient Text Animation ================= */
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .animate-gradient {
    animation: gradient 8s ease infinite;
  }

  /* ================= Scroll Reveal Animations ================= */
  . {
    opacity: 0;
    will-change: opacity, transform;
  }

  

  ..is-visible {
    opacity: 1;
    transform: translate(0);
  }

  /* Stagger Delays */
  .delay-100 { transition-delay: 0.1s; }
  .delay-200 { transition-delay: 0.2s; }
  .delay-300 { transition-delay: 0.3s; }

  @media (prefers-reduced-motion: reduce) {
    . {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ================= Swiper Customization ================= */
  swiper-container::part(bullet-active) {
    background: var(--color-primary);
    width: 24px;
    border-radius: var(--radius-sm);
    transition: width var(--duration-normal) var(--ease-default);
  }
  swiper-container::part(bullet) {
    background: rgba(255, 255, 255, 0.2);
    opacity: 1;
    transition: background var(--duration-normal) var(--ease-default), width var(--duration-normal) var(--ease-default);
  }
  swiper-container::part(bullet):hover {
    background: rgba(255, 255, 255, 0.5);
  }

  swiper-slide {
    height: auto !important;
    display: flex;
  }
</style>

<script>
  import { register } from 'swiper/element/bundle';
  
  // Initialize Scroll Animations
  function initWorkflowAnimations() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const elements = document.querySelectorAll('.');
    
    if (prefersReducedMotion) {
      elements.forEach(el => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    }, { root: null, rootMargin: '0px 0px -50px 0px', threshold: 0.1 });

    elements.forEach(el => observer.observe(el));
  }

  // Initialize Swiper
  function initSwiper() {
    register();
    const swiperEl = document.querySelector('swiper-container.mySwiper');
    if (swiperEl) {
      const swiperParams = {
        slidesPerView: 1.1,
        spaceBetween: 20,
        centeredSlides: false,
        grabCursor: true,
        pagination: {
          clickable: true,
          dynamicBullets: true,
        },
        breakpoints: {
          640: {
            slidesPerView: 2.1,
            spaceBetween: 24,
          },
          1024: {
            slidesPerView: 3,
            spaceBetween: 32,
            allowTouchMove: true, // تغییر دادم به true که تو دسکتاپ هم بشه درگ کرد (تجربه کاربری بهتر)
          },
        },
      };
      Object.assign(swiperEl, swiperParams);
      (swiperEl as any).initialize();
    }
  }

  // Run on load and after Astro view transitions
  document.addEventListener('DOMContentLoaded', () => {
    initSwiper();
    initWorkflowAnimations();
  });
  
  document.addEventListener('astro:page-load', () => {
    initSwiper();
    initWorkflowAnimations();
  });
</script>